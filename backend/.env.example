# Copie para .env e ajuste. O arquivo .env NÃO deve ir para o Git.
PORT=3000

# Banco de dados (MySQL local ou hospedado, ex.: TiDB Cloud Starter)
# TiDB Cloud: DB_PORT=4000, DB_USER completo (com prefixo) e DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=zerocarbon
# true para banco hospedado (exige SSL); false para MySQL local
DB_SSL=false

# Segredo do JWT (gere um valor longo e aleatório):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_valor_longo_e_aleatorio
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS, separadas por vírgula (sem barra no final).
# Em produção inclua o endereço do frontend publicado na Vercel.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Fuso usado para decidir "o mês atual" nos cálculos
APP_TIMEZONE=America/Sao_Paulo
