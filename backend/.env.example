# Copie para .env e ajuste. O arquivo .env NÃO deve ir para o Git.
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Amora123*
DB_NAME=zerocarbon

# Segredo do JWT (gere um valor longo e aleatório):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=fe1a13da482c392a68dc31a93efe8ca7f19895b05b579109374b219ff75cfbc4ebc66f74634b10de447796610a9186e1
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS, separadas por vírgula (sem barra no final).
# Em produção inclua o endereço do GitHub Pages: https://SEU_USUARIO.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Fuso usado para decidir "o mês atual" nos cálculos
APP_TIMEZONE=America/Sao_Paulo
